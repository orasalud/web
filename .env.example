# PostHog (analytics). If the key is empty, nothing is tracked and nothing breaks.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Resend (callback form emails). If RESEND_API_KEY is empty in local dev, leads are printed to the server console.
RESEND_API_KEY=
# Where leads are sent. Several addresses separated by commas are allowed.
LEAD_NOTIFY_EMAIL=
# Optional sender. Must be on a domain verified in Resend (e.g. "Orasalud <avisos@orasalud.com>").
# If empty, Resend's test sender is used, which only delivers to your own Resend account email.
LEAD_FROM_EMAIL=
